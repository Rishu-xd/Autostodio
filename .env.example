# AutoStudio Environment Configuration
# Copy this file to .env and insert your real Gemini API key

GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
GEMINI_CODE_MODEL=gemini-3.8-flash
GEMINI_REVIEW_MODEL=gemini-3.8-flash

# Studio Configuration
DEFAULT_VIDEO_QUALITY=low
MAX_REVISION_COUNT=3
MAX_RETRIES=3
RENDER_TIMEOUT_SECONDS=300
API_TIMEOUT_SECONDS=60.0

# Storage Paths (optional, defaults to local storage/ directory)
# AUTOSTUDIO_STORAGE_DIR=storage/projects
# AUTOSTUDIO_DB_PATH=storage/autostudio.db

